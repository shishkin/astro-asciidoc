{
  "name": "workspace",
  "version": "0.0.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter example run dev",
    "start": "pnpm run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prebuild": "pnpm run lint",
    "build": "pnpm -r --sequential run build",
    "prepare": "husky",
    "release": "pnpm --filter astro-asciidoc run release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@release-it/conventional-changelog": "12.0.2",
    "husky": "9.1.7",
    "release-it": "21.1.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
